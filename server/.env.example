# Copy to server/.env and fill in. Generate the first two lines with:
#   npm run set-password -- "your password"
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Where content.json and the uploaded photos live. Defaults to server/data.
# DATA_DIR=/var/lib/marsilabitri

# Marks the session cookie as https-only. Set this on the real server.
# NODE_ENV=production

# Hostinger mailbox that sends contact-form messages to hello@ and contact@.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=hello@marsilabitri.art
# SMTP_PASS=
# SMTP_FROM=hello@marsilabitri.art
